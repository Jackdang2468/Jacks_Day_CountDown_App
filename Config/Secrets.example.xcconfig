// Copy this file to Config/Secrets.xcconfig and fill in your Supabase values.
// Secrets.xcconfig is git-ignored so it never lands in the repository.
// Find both under Supabase dashboard > Project Settings > API.
SUPABASE_HOST = your-project-ref.supabase.co
SUPABASE_ANON_KEY = your-anon-or-publishable-key
